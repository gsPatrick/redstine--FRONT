# ---------------------------------------------------------------------------
# Front RED
# ---------------------------------------------------------------------------
# Endereço da API. Precisa do prefixo NEXT_PUBLIC_ porque as telas do painel
# chamam a API do lado do cliente — sem o prefixo, o Next não expõe a variável
# ao navegador.
#
# IMPORTANTE: esta variável é lida no BUILD, não na execução. No EasyPanel ela
# vai em "Build arguments"; defini-la só em "Environment" não tem efeito no
# JavaScript que roda no navegador.
NEXT_PUBLIC_API_URL=https://api.redestine.com.br/api/v1
